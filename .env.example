# Database PostgreSQL + pgvector
POSTGRES_DB=campusmate
POSTGRES_USER=campusmate_user
POSTGRES_PASSWORD=campusmate_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://campusmate_user:campusmate_secure_pass_2026@localhost:5432/campusmate

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=campusmate_minio
MINIO_ROOT_PASSWORD=minio_secure_pass_2026
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=false

# Security & JWT
JWT_SECRET=campusmate_jwt_super_secret_key_prod_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML & LLM API (OpenAI compatible / vLLM / Ollama)
OPENAI_API_KEY=your_openai_or_vllm_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Embedding & Reranker models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

